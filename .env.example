NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
NUXT_SUPABASE_SERVICE_ROLE_KEY=
# Protein swaps (D2) and adjusting plans by text (I3), server-only secret. Without it the app works with no AI: new swaps
# are unavailable and the plan page does not offer "Adjust with text".
NUXT_GEMINI_API_KEY=
# Optional: defaults to gemini-flash-latest
NUXT_GEMINI_MODEL=
# Scheduled jobs (H2), server-only secret of POST /api/cron/*: at least 32 characters, e.g. `openssl rand -hex 32`
NUXT_CRON_SECRET=
